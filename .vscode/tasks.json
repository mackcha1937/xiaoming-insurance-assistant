{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Phase Gate: Local",
      "type": "shell",
      "command": "./scripts/phase-gate.sh",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/Users/zzymima0000/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
        }
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Maven: Compile",
      "type": "shell",
      "command": "./mvnw -DskipTests compile",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/Users/zzymima0000/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
        }
      },
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Maven: Tests without E2E",
      "type": "shell",
      "command": "./mvnw test",
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "JAVA_HOME": "/Users/zzymima0000/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
        }
      },
      "group": "test",
      "problemMatcher": ["$javac"]
    },
    {
      "label": "Frontend: Install Exact Dependencies",
      "type": "shell",
      "command": "npm ci --no-audit --no-fund",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    },
    {
      "label": "Frontend: Test and Build",
      "type": "shell",
      "command": "npm test && npm run build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Frontend: Dev Server",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Maven: DeepSeek E2E",
      "type": "shell",
      "command": "set -a; source .env.local; set +a; ./mvnw -Plive-e2e -Dtest=XiaomingDeepSeekLiveE2ETest test",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        },
        "env": {
          "JAVA_HOME": "/Users/zzymima0000/Library/Java/JavaVirtualMachines/temurin-21.jdk/Contents/Home"
        }
      },
      "group": "test",
      "problemMatcher": ["$javac"]
    }
  ]
}
