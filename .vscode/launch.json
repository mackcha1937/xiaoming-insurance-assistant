{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Backend: Local (H2 + BM25)",
      "request": "launch",
      "mainClass": "com.embabel.insurance.EmbabelApplication",
      "projectName": "embabel-insurance",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env.local",
      "env": {
        "SPRING_PROFILES_ACTIVE": "local",
        "XIAOMING_KNOWLEDGE_IMPORT_ENABLED": "true",
        "XIAOMING_KNOWLEDGE_SOURCE_DIRECTORY": "${workspaceFolder}/docs/source-materials/product-36743/raw",
        "XIAOMING_SPREADSHEET_SCAN_MODE": "STRUCTURE_ONLY",
        "XIAOMING_MODEL_ENABLED": "false"
      },
      "console": "integratedTerminal"
    }
  ]
}
